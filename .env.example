# Copy to .env and fill in only what you need. .env is git-ignored.
# The defaults run the whole pipeline locally with no accounts or keys.

# --- Mode -----------------------------------------------------------------
# local: filesystem landing zone + DuckDB   |   cloud: Azure Blob + Snowflake
PIPELINE_MODE=local
# sample: replay data/sample   |   api: call the real market data APIs
MARKET_DATA_SOURCE=sample
# Rows per generated ledger batch (the original ran 50000)
LEDGER_ROWS=1000

# --- Docker ---------------------------------------------------------------
AIRFLOW_PORT=8080
# On Linux, set to `id -u` so files written to ./data are owned by you
AIRFLOW_UID=50000

# --- Market data APIs (MARKET_DATA_SOURCE=api) ----------------------------
# exchangeratesapi.io, metalpriceapi.com, alphavantage.co (all have free tiers)
EXCHANGE_RATES_API_KEY=
METAL_PRICE_API_KEY=
ALPHA_VANTAGE_API_KEY=
# Optional alternative to the three keys above: an AWS Secrets Manager secret
# holding them as JSON (uses the standard AWS credential chain)
AWS_SECRET_NAME=
AWS_DEFAULT_REGION=

# --- Cloud mode: Snowflake (dbt) ------------------------------------------
# The Airflow load tasks use the `snowflake_default` connection instead, e.g.
# AIRFLOW_CONN_SNOWFLAKE_DEFAULT='{"conn_type": "snowflake", "login": "...", "password": "...", "extra": {"account": "...", "warehouse": "...", "database": "...", "role": "..."}}'
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=INVASIGHT_WH
SNOWFLAKE_DATABASE=INVASIGHT
SNOWFLAKE_STAGE=@INVASIGHT.RAW.LANDING_STAGE
AIRFLOW_CONN_SNOWFLAKE_DEFAULT=

# --- Cloud mode: Azure Blob Storage ---------------------------------------
BLOB_CONTAINER=landing
# e.g. '{"conn_type": "wasb", "login": "<storage-account>", "extra": {"sas_token": "..."}}'
AIRFLOW_CONN_WASB_DEFAULT=
